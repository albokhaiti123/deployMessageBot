# ─── Copy this file to .env and fill in your values ──────────────────────────

# Your bot token from @BotFather
BOT_TOKEN=1234567890:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Comma-separated Telegram user IDs for admins
ADMIN_IDS=123456789,987654321

# Your bot username (without @)
BOT_USERNAME=YourBotUsername

# SQLite (default) or PostgreSQL
DATABASE_URL=sqlite:///bot_database.db
# DATABASE_URL=postgresql://user:password@localhost:5432/botdb

# Set to "true" to require invite links to join
INVITE_ONLY=true

# Leave empty for Telegram Stars (XTR), or set provider token for other payments
STARS_PROVIDER_TOKEN=

# Timezone for scheduler (e.g. Asia/Riyadh, UTC, Europe/London)
SCHEDULER_TIMEZONE=Asia/Riyadh

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
